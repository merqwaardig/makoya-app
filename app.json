{
  "expo": {
    "name": "Makoya",
    "slug": "M1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
