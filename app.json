      "adaptiveIcon": {
        "foregroundImage": "./assets/favo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favo.png",
      "name": "Makoya",
      "shortName": "Makoya",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF",
      "display": "standalone"
    }
  }
}
